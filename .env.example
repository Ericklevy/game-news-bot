# Copie para .env e preencha. NUNCA suba o .env para o GitHub.
TELEGRAM_TOKEN=cole-aqui-o-token-do-BotFather
# Para onde vai o resumo: o id do seu chat ou um canal público (ex.: @ResumoGamerBR)
TELEGRAM_CHAT_ID=cole-aqui-o-id-do-chat-ou-o-@-do-canal
# Quem pode dar comandos como /agora (o id do SEU chat). Se ficar vazio, vale o TELEGRAM_CHAT_ID.
TELEGRAM_ADMIN_ID=

# IA para traduzir as notícias (opcional: preencha só as que tiver)
OPENROUTER_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
SAMBANOVA_API_KEY=
